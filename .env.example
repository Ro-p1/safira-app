# Salin file ini jadi .env dan isi dengan kredensial project Supabase kamu
# (Project Settings -> API di dashboard Supabase)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Catatan: ANTHROPIC_API_KEY TIDAK diisi di sini (client-side).
# Kalau mau mengaktifkan narasi AI, set sebagai Supabase Edge Function secret:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-xxxx
# Ini OPSIONAL — tanpa ini pun app tetap berjalan penuh dengan narasi template lokal.
